# No authentication! Bind only to a trusted LAN/VPN IP, never public internet.
BIND_IP=127.0.0.1
PORT=8080
MAX_UPLOAD_BYTES=4294967296
MAX_VIDEO_SECONDS=7200
TASK_TIMEOUT_SECONDS=21600
# Build-time sources: fast official CDN by default; snapshot opts into fixed APT versions.
# Switching to snapshot can be slower. Both modes verify Debian signatures/hashes.
APT_SOURCE_MODE=mirror
DEBIAN_MIRROR=https://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=https://deb.debian.org/debian-security
DEBIAN_SNAPSHOT=20260901T000000Z
# Runtime model configuration. Never commit real keys. Quote values with single
# quotes in .env to preserve literal $ and # characters (escape ' as \').
# On web startup each non-empty group replaces that model's saved configuration.
# BASE_URL + MODEL are required together; blank API_KEY means no authentication.
# All three blank = preserve the database; removing env does NOT erase saved keys.
# UI edits work until the next web restart. No model requests occur at startup.
AUTOCLIP_TEXT_BASE_URL=
AUTOCLIP_TEXT_MODEL=
AUTOCLIP_TEXT_API_KEY=
AUTOCLIP_VISION_BASE_URL=
AUTOCLIP_VISION_MODEL=
AUTOCLIP_VISION_API_KEY=
